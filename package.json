{
  "name": "detroit-city-intelligence-pipeline",
  "private": true,
  "version": "0.1.0",
  "description": "Public data-refresh pipeline for Detroit City Intelligence: City of Detroit open data snapshots, diffs, health, and a keyless basemap",
  "license": "MIT",
  "repository": "github:gparker195/detroit-city-intelligence-pipeline",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "test:meetings": "cd services/meetings && .venv/bin/python -m unittest discover -s tests -t . -v",
    "publish:folder": "bash scripts/publish.sh dist/public"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "typescript": "^5.9.3"
  }
}
