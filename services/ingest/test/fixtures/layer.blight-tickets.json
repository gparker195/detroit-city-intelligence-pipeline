e\"}"},{"name":"ticket_issued_time","type":"esriFieldTypeTimeOnly","alias":"Ticket Issued Time","sqlType":"sqlTypeOther","nullable":true,"editable":true,"domain":null,"defaultValue":null,"description":"{\"value\": \"Time the ticket was issued.\", \"fieldValueType\": \"dateAndTime\"}"},{"name":"hearing_date","type":"esriFieldTypeDateOnly","alias":"Hearing Date","sqlType":"sqlTypeOther","nullable":true,"editable":true,"domain":null,"defaultValue":null,"description":"{\"value\": \"Assigned DAH court hearing date.\", \"fieldValueType\": \"dateAndTime\"}"},{"name":"hearing_time","type":"esriFieldTypeTimeOnly","alias":"Hearing Time","sqlType":"sqlTypeOther","nullable":true,"editable":true,"domain":null,"defaultValue":null,"description":"{\"value\": \"Time of the hearing.\", \"fieldValueType\": \"dateAndTime\"}"},{"name":"judgment_date","type":"esriFieldTypeDateOnly","alias":"Judgement Date","sqlType":"sqlTypeOther","nullable":true,"editable":true,"domain":null,"defaultValue":null,"description":"{\"value\": \"Assigned DAH court hearing time.\", \"fieldValueType\": \"dateAndTime\"}"},{"name":"payment_date","type":"esriFieldTypeDateOnly","alias":"Payment Date","sqlType":"sqlTypeOther","nullable":true,"editable":true,"domain":null,"defaultValue":null,"description":"{\"value\": \"Date when payment for the blight violation ticket was made.\", \"fieldValueType\": \"dateAndTime\"}"},{"name":"ticket_updated_at","type":"esriFieldTypeDate","alias":"Ticket Updated At","sqlType":"sqlTypeOther","length":8,"nullable":true,"editable":true,"domain":null,"defaultValue":null,"description":"{\"value\": \"Date the ticket was last updated.\", \"fieldValueType\": \"dateAndTime\"}","precision":1},{"name":"amt_fine","type":"esriFieldTypeDouble","alias":"Fine Amount","sqlType":"sqlTypeOther","nullable":true,"editable":true,"domain":null,"defaultValue":null,"description":"{\"value\": \"Fine assessed for for the violation, excluding fees.\"}"},{"name":"amt_admin_fee","type":"esriFieldTypeDouble","alias":"Admin Fee","sqlType":"sqlTypeOther","nullable":true,"editable":true,"domain":null,"defaultValue":null,"description":"{\"value\": \"Legislatively-mandated city administrative fee, assessed for the processing and adjudication of a Blight Violation Notice.\"}"},{"name":"amt_state_fee","type":"esriFieldTypeDouble","alias":"State Fee","sqlType":"sqlTypeOther","nullable":true,"editable":true,"domain":null,"defaultValue":null,"description":"{\"value\": \"Legislatively-mandated State Justice Assessment charged for the processing and adjudication of a Blight Violation Notice.\"}"},{"name":"amt_late_fee","type":"esriFieldTypeDouble","alias":"Late Fee","sqlType":"sqlTypeOther","nullable":true,"editable":true,"domain":null,"defaultValue":null,"description":"{\"value\": \"Late penalty assessed for a fine paid after the court hearing date.\"}"},{"name":"amt_discount","type":"esriFieldTypeDouble","alias":"Discount Amount","sqlType":"sqlTypeOther","nullable":true,"editable":true,"domain":null,"defaultValue":null,"description":"{\"value\": \"Discount applied, including for a fine paid before the court hearing date.\"}"},{"name":"amt_clean_up_cost","type":"esriFieldTypeDouble","alias":"Clean Up Cost","sqlType":"sqlTypeOther","nullable":true,"editable":true,"domain":null,"defaultValue":null,"description":"{\"value\": \"Costs assessed for clean up, if applicable.\"}"},{"name":"amt_judgment","type":"esriFieldTypeDouble","alias":"Judgement Amount","sqlType":"sqlTypeOther","nullable":true,"editable":true,"domain":null,"defaultValue":null,"description":"{\"value\": \"The total amount of the judgment for the blight violation.\"}"},{"name":"amt_payment","type":"esriFieldTypeDouble","alias":"Payment Amount","sqlType":"sqlTypeOther","nullable":true,"editable":true,"domain":null,"defaultValue":null,"description":"{\"value\": \"Amount of payment received for the blight violation.\"}"},{"name":"amt_balance_due","type":"esriFieldTypeDouble","alias":"Balance Due","sqlType":"sqlTypeOther","nul